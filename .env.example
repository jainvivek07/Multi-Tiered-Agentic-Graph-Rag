PROJECT_NAME="Tiered Agentic Graph RAG"
API_V1_STR="/api/v1"

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="YOUR_SUPER_SECRET_KEY_CHANGE_ME"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_SERVER="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="rag_db"

# Neo4j AuraDB
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

# Redis / Upstash / Redis Cloud
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DECODE_RESPONSES=True
REDIS_USERNAME="default"
REDIS_PASSWORD=""
SEMANTIC_CACHE_THRESHOLD=0.8

# LLM API Keys
GROQ_API_KEY=""
NAGA_API_KEY=""

# Model Names (all overridable)
ROUTER_MODEL="groq/llama-3.1-70b-versatile"
CYPHER_MODEL="naga/nvidia/nemotron-4-340b-instruct"
SYNTHESIS_MODEL="naga/nvidia/nemotron-4-340b-instruct"
EMBEDDING_MODEL="text-embedding-3-small"
RERANKER_MODEL="ms-marco-MiniLM-L-12-v2"

# LangSmith Observability
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="tiered-agentic-rag"

# Agent Behaviour (tunable without code changes)
CHAT_HISTORY_WINDOW_SIZE=5
CYPHER_MAX_RETRIES=3
VECTOR_TOP_K=20
VECTOR_RERANK_TOP_K=5
EMBEDDING_DIMENSIONS=1024

# Neo4j Read-Only User (for user-facing Cypher queries — limited to READ + TRAVERSE)
# Create this user in Neo4j with: CREATE USER reader_client SET PASSWORD '...' CHANGE NOT REQUIRED;
# Then: GRANT ROLE query_reader TO reader_client;
NEO4J_READER_USER="reader_client"
NEO4J_READER_PASSWORD="StrongReaderPass123"

# Celery Task Queue (uses Redis DB 1 for broker, DB 2 for result backend)
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Parallel LLM extraction — max concurrent calls per document ingestion
EXTRACTION_CONCURRENCY=10

# CORS — explicit list of allowed frontend origins (comma-separated in env, parsed as JSON list)
ALLOWED_ORIGINS='["http://localhost:3000"]'

RATE_LIMIT_ENABLED = True
RATE_LIMIT_STORAGE_URI = "memory://"
RATE_LIMIT_DEFAULT = "60/minute"
RATE_LIMIT_AUTH = "5/minute"
RATE_LIMIT_CHAT = "10/minute"